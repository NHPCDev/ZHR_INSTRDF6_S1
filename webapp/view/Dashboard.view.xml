<mvc:View
    controllerName="com.nhpc.zhrinstrdf6s1.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    class="sapUiSizeCompact"
>
    <f:DynamicPage
        id="_IDGenDynamicPage1"
        headerExpanded="true"
        showFooter="true"
    >
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        persistencyKey="myPersKey"
                        useToolbar="false"
                        search=".onSearchBtn"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem3"
                                name="SerialNumber"
                                label="{i18n>sno}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="serialNumber"
                                        value="{viewModel>/filterData/Sno}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem1"
                                name="EmployeeNumber"
                                label="{i18n>empNo}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="EmployeeNumber"
                                        value="{viewModel>/filterData/Pernr}"
                                        showValueHelp="true"
                                        app:valuehelp="EmployeeNumber"
                                        valueHelpRequest="onValueHelpRequest"
                                        change="onValueHelpChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem2"
                                name="CreatedOn"
                                label="{i18n>createdOn}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idCreatedOn"
                                        value="{viewModel>/filterData/Createdon}"
                                        displayFormat="dd.MM.yyyy"
                                        valueFormat="yyyyMMdd"
                                        change="onDateChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem4"
                                name="Status"
                                label="{i18n>status}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <ComboBox
                                        id="status"
                                        selectedKey="{viewModel>/filterData/Status}"
                                        items="{/ZHR_CDS_IT_STCODEFORM6_F4H}"
                                        change="onComboboxChange"
                                    >
                                        <core:Item
                                            key="{StatusCode}"
                                            text="{Statustext}"
                                        />
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox
                id="_IDGenVBox1"
            >
                <table:Table
                    id="idDashboardTable"
                    rows="{/WaiverregisterSet}"
                    selectionMode="Single"
                    rowSelectionChange="onListItemPress"
                    width="100%"
                    fixedColumnCount="2"
                    class="sapUiSmallMarginTop"
                    alternateRowColors="true"
                    selectionBehavior="RowOnly"
                    threshold="20"
                >
                    <table:rowMode>
                        <rowmodes:Fixed
                            rowCount="6"
                            rowContentHeight="50%"
                        />
                    </table:rowMode>
                    <table:extension>
                        <OverflowToolbar>
                            <Title
                                id="dashBoardTitle"
                                text="{= ${i18n>dashboardTableTitle} + ' (' + (${viewModel>/dashboardCount} || 0) + ')' }"
                            />
                            <ToolbarSpacer />
                            <Button
                                text="{i18n>add}"
                                press="onAddPress"
                                type="Emphasized"
                                icon="sap-icon://add"
                            />
                            <Button
                                text="{i18n>downloadReport}"
                                press="onDownload"
                                type="Reject"
                                icon="sap-icon://excel-attachment"
                            />
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column
                            width="100px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>sno}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectIdentifier title="{Sno}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>empNo}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectIdentifier
                                    title="{Pernr}"
                                    text="{Empname}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>designation}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Designation}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>department}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Dept}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>nameOfTheImmediateRelative}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Relativename}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>numberOfSharesSecurities}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{path:'Shareno',formatter:'.formatter.formatNumbers'}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>considerationValue}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{path:'Considrationvalue',formatter:'.formatter.formatAmountToINR'}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>reasonsForWaiver}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Waiverreason}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>dateOfCommunication}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'Waivercommdate', formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>remarks}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Remarks}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>createdBy}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Createdby}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>createdOn}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'Createdon', formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>status}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectStatus
                                    text="{Status}"
                                    class="sapMObjectStatusMedium statusBoldText"
                                    state="{path:'Status',formatter:'.formatter.formatStatusState'}"
                                />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
